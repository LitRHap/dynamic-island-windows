<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Foreground="White"
        Title="Dynamic Island" Width="480" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.84" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.84" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <ElasticEase Oscillations="1" Springiness="4" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.07"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.07"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid IsHitTestVisible="False">
            <Grid.RenderTransform><TranslateTransform Y="3"/></Grid.RenderTransform>
            <Path x:Name="ShadowA" Stroke="#0A000000" StrokeThickness="22" StrokeLineJoin="Round"/>
            <Path x:Name="ShadowB" Stroke="#10000000" StrokeThickness="13" StrokeLineJoin="Round"/>
            <Path x:Name="ShadowC" Stroke="#1A000000" StrokeThickness="6" StrokeLineJoin="Round"/>
        </Grid>
        <Grid x:Name="Island" AllowDrop="True"
              PreviewMouseWheel="Island_MouseWheel"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
              DragEnter="Island_DragEnter" DragOver="Island_DragOver"
              DragLeave="Island_DragLeave" Drop="Island_Drop">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="AutoStartItem" Header="Mulai otomatis dengan Windows" IsCheckable="True" Click="AutoStart_Click"/>
                    <Separator/>
                    <MenuItem Header="Keluar" Click="Exit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Image x:Name="BackdropImg" Stretch="Fill" Width="480" Height="230"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Rectangle x:Name="TintRect"/>
            <Grid x:Name="GlassLayers" IsHitTestVisible="False" Width="170" Height="32"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RenderTransform><TranslateTransform x:Name="GlassPos"/></Grid.RenderTransform>
                <Rectangle Fill="#1CFFFFFF"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                            <GradientStop Color="#10FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.62"/>
                            <GradientStop Color="#26000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                            <GradientStop Color="#26FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.38"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.72"/>
                            <GradientStop Color="#18FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <Grid x:Name="ContentHost" Width="170" Height="32"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RenderTransform><TranslateTransform x:Name="ContentPos"/></Grid.RenderTransform>
                <Grid x:Name="CollapsedView">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <TextBlock x:Name="CollapsedText" Foreground="White" FontSize="13" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                    <local:Glyph x:Name="CapsBadge" Kind="caps" Width="15" Height="15" Opacity="0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <local:Glyph x:Name="DlBadge" Kind="download" Width="13" Height="13" Opacity="0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="38,0,0,0"/>
                    <Border x:Name="DlTrack" Width="110" Height="3" CornerRadius="1.5" Background="#33FFFFFF" Opacity="0"
                            ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,4" IsHitTestVisible="False">
                        <Border Width="40" HorizontalAlignment="Left" CornerRadius="1.5" Background="#F0FFFFFF">
                            <Border.RenderTransform><TranslateTransform x:Name="DlSweepX" X="-40"/></Border.RenderTransform>
                        </Border>
                    </Border>
                    <local:Glyph x:Name="TimerBadge" Kind="clock" Width="13" Height="13" Opacity="0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="42,0,0,0"/>
                    <StackPanel x:Name="EqPanel" Orientation="Horizontal" Opacity="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Rectangle Width="3" Height="14" Margin="1,0" Fill="White" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq1" ScaleY="0.25"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1,0" Fill="White" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq2" ScaleY="0.25"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1,0" Fill="White" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq3" ScaleY="0.25"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="3" Height="14" Margin="1,0" Fill="White" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq4" ScaleY="0.25"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ToastView" Visibility="Collapsed" Opacity="0" Width="250"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <local:Glyph x:Name="ToastIcon" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastLabel" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid x:Name="ToastTrack" Width="190" Height="4" HorizontalAlignment="Left" Margin="0,6,0,0">
                            <Border Background="#44FFFFFF" CornerRadius="2"/>
                            <Border x:Name="ToastFill" Background="White" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="ExpandedView" Visibility="Collapsed" Opacity="0" Width="382" Height="128"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" AllowDrop="True">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>

                    <Grid x:Name="PageCalendar" Height="140" VerticalAlignment="Top">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="178"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Button Style="{StaticResource IconBtn}" Width="26" Height="20" HorizontalAlignment="Left" Click="CalPrev_Click">
                                    <local:Glyph Kind="chev-l" Width="12" Height="12"/>
                                </Button>
                                <TextBlock x:Name="CalTitle" Background="Transparent" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                           ToolTip="Kembali ke hari ini" MouseLeftButtonDown="CalTitle_Click"/>
                                <Button Style="{StaticResource IconBtn}" Width="26" Height="20" HorizontalAlignment="Right" Click="CalNext_Click">
                                    <local:Glyph Kind="chev-r" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                            <UniformGrid x:Name="CalDow" Grid.Row="1" Columns="7" Margin="1,0"/>
                            <UniformGrid x:Name="CalGrid" Grid.Row="2" Columns="7" Rows="6"/>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="EvDateText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,28,0"/>
                                <Button Style="{StaticResource IconBtn}" Width="26" Height="22" HorizontalAlignment="Right"
                                        ToolTip="Tambah event" Click="AddEv_Click">
                                    <local:Glyph Kind="plus" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                            <Border x:Name="EvAddBox" Grid.Row="1" Visibility="Collapsed" Height="26" Margin="0,0,0,4"
                                    CornerRadius="13" Background="#26FFFFFF" Padding="11,0">
                                <Grid>
                                    <TextBox x:Name="EvInput" Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="White" CaretBrush="White" FontSize="12" MaxLength="80"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             TextChanged="EvInput_TextChanged" KeyDown="EvInput_KeyDown"
                                             LostKeyboardFocus="EvInput_LostFocus"/>
                                    <TextBlock x:Name="EvHint" Text="14:00 Rapat tim, lalu Enter" Foreground="#80FFFFFF" FontSize="11.5"
                                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ListBox x:Name="EvList" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeText}" Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="2" Tag="{Binding}" Click="EvDelete_Click" Visibility="{Binding DelVisibility}"
                                                    Style="{StaticResource IconBtn}" Width="22" Height="18">
                                                <local:Glyph Kind="close" Width="9" Height="9" Foreground="#AAFFFFFF"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EvEmpty" Grid.Row="2" Text="Tidak ada event" Foreground="#99FFFFFF" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12" IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PageMedia" Height="92" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Width="64" Height="64" RadiusX="12" RadiusY="12" Fill="#33000000"/>
                            <Rectangle Width="64" Height="64" RadiusX="12" RadiusY="12">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Foreground="#CCFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="-6,4,0,0">
                                    <Button Style="{StaticResource IconBtn}" Click="Prev_Click"><local:Glyph Kind="prev" Width="17" Height="17"/></Button>
                                    <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Click="Play_Click"><local:Glyph x:Name="PlayGlyph" Kind="play" Width="18" Height="18"/></Button>
                                    <Button Style="{StaticResource IconBtn}" Click="Next_Click"><local:Glyph Kind="next" Width="17" Height="17"/></Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Height="18" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PosText" Text="0:00" Foreground="#CCFFFFFF" FontSize="10" VerticalAlignment="Center"/>
                            <Grid x:Name="ProgTrack" Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Prog_Down">
                                <Border Height="4" CornerRadius="2" Background="#44FFFFFF" VerticalAlignment="Center"/>
                                <Border x:Name="ProgFill" Height="4" CornerRadius="2" Background="White"
                                        VerticalAlignment="Center" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                            <TextBlock x:Name="DurText" Grid.Column="2" Text="0:00" Foreground="#CCFFFFFF" FontSize="10"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PageTimer" Height="92" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TimerText" Text="00:00" FontSize="40" FontWeight="Light" Foreground="White"
                                   VerticalAlignment="Center" Margin="6,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconBtn}" Content="1m" FontSize="12" Width="40" Height="28" Tag="1" Click="Preset_Click"/>
                                <Button Style="{StaticResource IconBtn}" Content="5m" FontSize="12" Width="40" Height="28" Tag="5" Click="Preset_Click"/>
                                <Button Style="{StaticResource IconBtn}" Content="10m" FontSize="12" Width="40" Height="28" Tag="10" Click="Preset_Click"/>
                                <Button Style="{StaticResource IconBtn}" Content="25m" FontSize="12" Width="40" Height="28" Tag="25" Click="Preset_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button x:Name="TimerPauseBtn" Style="{StaticResource IconBtn}" Click="TimerPause_Click"><local:Glyph x:Name="TimerGlyph" Kind="play" Width="18" Height="18"/></Button>
                                <Button Style="{StaticResource IconBtn}" Click="TimerReset_Click"><local:Glyph Kind="reset" Width="16" Height="16"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageFiles" Height="92" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" AllowDrop="True">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="4 3" Fill="#14FFFFFF"/>
                        <TextBlock x:Name="FilesHint" Text="Seret file ke sini lalu seret keluar kapan saja"
                                   Foreground="#CCFFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0" Margin="4"
                                 HorizontalContentAlignment="Stretch" AllowDrop="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonDown="FileList_PreviewMouseDown"
                                 PreviewMouseMove="FileList_PreviewMouseMove"
                                 MouseDoubleClick="FileList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:Glyph Kind="file" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="#CCFFFFFF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Display}" Foreground="White" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Tag="{Binding}" Click="RemoveShelf_Click"
                                                Style="{StaticResource IconBtn}" Width="24" Height="20">
                                            <local:Glyph Kind="close" Width="9" Height="9"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>


                    <Grid x:Name="PageStats" Height="120" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <local:Glyph x:Name="NetKindGlyph" Kind="wifi" Width="15" Height="15" Foreground="#CCFFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WifiName" Text="--" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                           Margin="7,0,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="WifiUsage" Foreground="#CCFFFFFF" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="CPU" Foreground="#CCFFFFFF" FontSize="11"/>
                                <TextBlock x:Name="CpuText" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="CpuTrack" Height="6" Margin="0,4,0,0">
                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                <Border x:Name="CpuFill" Background="White" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="RAM" Foreground="#CCFFFFFF" FontSize="11"/>
                                <TextBlock x:Name="RamText" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="RamTrack" Height="6" Margin="0,4,0,0">
                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                <Border x:Name="RamFill" Background="White" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="GPU" Foreground="#CCFFFFFF" FontSize="11"/>
                                <TextBlock x:Name="GpuText" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid x:Name="GpuTrack" Height="6" Margin="0,4,0,0">
                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                <Border x:Name="GpuFill" Background="White" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Jaringan" Foreground="#CCFFFFFF" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <local:Glyph Kind="arrow-down" Width="11" Height="11" VerticalAlignment="Center" Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="NetDownText" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="3,0,10,0"/>
                                <local:Glyph Kind="arrow-up" Width="11" Height="11" VerticalAlignment="Center" Foreground="#CCFFFFFF"/>
                                <TextBlock x:Name="NetUpText" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="3,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageControl" Height="120" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:Glyph Kind="volume-3" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Grid x:Name="VolTrack" Grid.Column="1" Tag="vol" Height="26" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Slider_Down" MouseMove="Slider_Move" MouseLeftButtonUp="Slider_Up">
                                <Border Background="#33FFFFFF" CornerRadius="13"/>
                                <Border x:Name="VolFill" Background="#EEFFFFFF" CornerRadius="13" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Grid>
                        <Grid x:Name="BriRow" Grid.Row="1" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:Glyph Kind="sun" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Grid x:Name="BriTrack" Grid.Column="1" Tag="bri" Height="26" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Slider_Down" MouseMove="Slider_Move" MouseLeftButtonUp="Slider_Up">
                                <Border Background="#33FFFFFF" CornerRadius="13"/>
                                <Border x:Name="BriFill" Background="#EEFFFFFF" CornerRadius="13" HorizontalAlignment="Left" Width="0"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Button x:Name="TileWifi" Style="{StaticResource TileBtn}" Tag="wifi" Click="Tile_Click"><local:Glyph Kind="wifi" Width="21" Height="21"/></Button>
                            <Button x:Name="TileBt" Style="{StaticResource TileBtn}" Tag="bt" Click="Tile_Click"><local:Glyph Kind="bluetooth" Width="21" Height="21"/></Button>
                            <Button x:Name="TileMute" Style="{StaticResource TileBtn}" Tag="mute" Click="Tile_Click"><local:Glyph Kind="volume-0" Width="21" Height="21"/></Button>
                            <Button Style="{StaticResource TileBtn}" Tag="shot" Click="Tile_Click"><local:Glyph Kind="shot" Width="21" Height="21"/></Button>
                            <Button Style="{StaticResource TileBtn}" Tag="lock" Click="Tile_Click"><local:Glyph Kind="lock" Width="21" Height="21"/></Button>
                            <Button Style="{StaticResource TileBtn}" Tag="settings" Click="Tile_Click"><local:Glyph Kind="gear" Width="21" Height="21"/></Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageNotif" Height="104" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <Rectangle RadiusX="12" RadiusY="12" Fill="#14FFFFFF" Stroke="#44FFFFFF" StrokeThickness="1"/>
                        <TextBlock x:Name="NotifHint" Text="Memuat..." Foreground="#CCFFFFFF" FontSize="12"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,16,28"/>
                        <ListBox x:Name="NotifList" Background="Transparent" BorderThickness="0" Margin="4,4,4,32"
                                 HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Body}" Foreground="#CCFFFFFF" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource IconBtn}" Content="Buka Pusat Notifikasi" FontSize="11"
                                Width="150" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,6,4" Click="OpenNotifCenter_Click"/>
                    </Grid>

                    <!-- Tab + baterai -->
                    <Grid VerticalAlignment="Bottom" Height="26">
                        <StackPanel x:Name="LeftSlot" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                            <local:Glyph x:Name="LeftGlyph" Kind="headphones" Width="14" Height="14" Margin="0,0,3,0" Foreground="#CCFFFFFF"/>
                            <TextBlock x:Name="LeftText" Foreground="#CCFFFFFF" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="TabCal" Style="{StaticResource TabBtn}" Tag="calendar" Click="Tab_Click"><local:Glyph Kind="calendar" Width="15" Height="15"/></Button>
                            <Button x:Name="TabMedia" Style="{StaticResource TabBtn}" Tag="media" Click="Tab_Click"><local:Glyph Kind="music" Width="15" Height="15"/></Button>
                            <Button x:Name="TabStats" Style="{StaticResource TabBtn}" Tag="stats" Click="Tab_Click"><local:Glyph Kind="chart" Width="15" Height="15"/></Button>
                            <Button x:Name="TabCtrl" Style="{StaticResource TabBtn}" Tag="control" Click="Tab_Click"><local:Glyph Kind="sliders" Width="15" Height="15"/></Button>
                            <Button x:Name="TabNotif" Style="{StaticResource TabBtn}" Tag="notif" Click="Tab_Click"><local:Glyph Kind="bell" Width="15" Height="15"/></Button>
                            <Button x:Name="TabTimer" Style="{StaticResource TabBtn}" Tag="timer" Click="Tab_Click"><local:Glyph Kind="clock" Width="15" Height="15"/></Button>
                            <Button x:Name="TabFiles" Style="{StaticResource TabBtn}" Tag="files" Click="Tab_Click"><local:Glyph Kind="folder" Width="15" Height="15"/></Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <local:Glyph x:Name="BatteryGlyph" Kind="battery" Width="14" Height="14" Margin="0,0,3,0" Foreground="#CCFFFFFF"/>
                            <TextBlock x:Name="BatteryText" Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

            </Grid>
        </Grid>

        <Path x:Name="Rim2" StrokeThickness="7" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                    <GradientStop Color="#26FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#0CFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
        <Path x:Name="Rim" StrokeThickness="1.3" IsHitTestVisible="False">
            <Path.Stroke>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D0FFFFFF" Offset="0"/>
                    <GradientStop Color="#34FFFFFF" Offset="0.32"/>
                    <GradientStop Color="#1CFFFFFF" Offset="0.55"/>
                    <GradientStop Color="#78FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
        </Path>
    </Grid>
</Window>
